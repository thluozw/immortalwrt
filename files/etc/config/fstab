config global
	option anon_swap '0'
	option anon_mount '0'
	option auto_swap '1'
	option auto_mount '1'
	option delay_root '5'
	option check '0'

config device
	option name 'mmcblk0p22'
	option uuid '15874cc2-51d7-426a-88eb-2697600662b1'

config mount
	option target '/overlay'
	option device '/dev/mmcblk0p22'
	option uuid '15874cc2-51d7-426a-88eb-2697600662b1'
	option options 'rw,noatime'
	option enabled '1'
	option enabled_fsck '0'